# Pooled Neon/Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Long random string (e.g. `openssl rand -base64 48`). Never commit the real value.
JWT_SIGNING_SECRET=""
# Platform admin console (/admin). At least 32 random characters, server only.
# Signs MFA step tokens and encrypts MFA secrets; rotating it forces every
# administrator to re-enrol their authenticator app.
PLATFORM_ADMIN_SECRET=""
NEXT_PUBLIC_STORE_ORIGIN=
NEXT_PUBLIC_SITE_ORIGIN=

# ---------------------------------------------------------------------------
# Transactional email (Resend). Placeholders only. See docs/EMAIL.md.
# ---------------------------------------------------------------------------
# Master switch. Anything other than "true" keeps email off; the app still works.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
# Server-side only. Create in the Resend dashboard (sending access is enough).
RESEND_API_KEY=""
# Sender. Leave the address empty to use Resend's test sender (onboarding@resend.dev),
# which only delivers to the Resend account owner. Use an address on your VERIFIED domain
# for real delivery. Do not use the Gmail address here.
EMAIL_FROM_NAME="Insight"
EMAIL_FROM_ADDRESS=""
# Replies and all admin/contact mail go here (a Gmail inbox that only RECEIVES).
EMAIL_REPLY_TO="stylintech.x@gmail.com"
EMAIL_CONTACT_ADDRESS="stylintech.x@gmail.com"
EMAIL_ADMIN_ADDRESS="stylintech.x@gmail.com"
# Webhook signing secret from Resend (starts with whsec_).
EMAIL_WEBHOOK_SECRET=""
# Base URL used for every link in an email. Defaults to the current production URL.
APP_PUBLIC_URL=""
# Protects /api/cron/email (retries and daily summaries). Vercel sends it automatically.
CRON_SECRET=""
