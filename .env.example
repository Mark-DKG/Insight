# Pooled Neon/Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Long random string (e.g. `openssl rand -base64 48`). Never commit the real value.
JWT_SIGNING_SECRET=""
# Platform admin console (/admin). At least 32 random characters, server only.
# Signs MFA step tokens and encrypts MFA secrets; rotating it forces every
# administrator to re-enrol their authenticator app.
PLATFORM_ADMIN_SECRET=""
