// ============================================================================
// Insight by 9DEVs — Prisma Schema
// PostgreSQL, multi-tenant (every business-owned table carries businessId)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
  VOIDED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGED
  EXPIRED
  RETURNED
  COUNT_CORRECTION
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  TRANSPORT
  SALARIES
  MAINTENANCE
  MARKETING
  INTERNET
  OTHER
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  DEAD_STOCK
  STOCK_DISCREPANCY
  CUSTOMER_CREDIT_DUE
  SUPPLIER_PAYMENT_DUE
  SYNC_ERROR
  TRANSACTION_FAILED
  GENERAL
}

// ----------------------------------------------------------------------------
// Tenant root
// ----------------------------------------------------------------------------

enum AppMode {
  FULL
  INVENTORY_ONLY
}

model Business {
  id            String   @id @default(uuid())
  name          String
  logoUrl       String?
  address       String?
  phone         String?
  email         String?
  currency      String   @default("GHS")
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  isDemo        Boolean  @default(false)
  // Counter reserved for sequential receipt numbering.
  receiptCounter Int     @default(0)
  // Per-business preferences (inventory, POS, notification settings).
  settings      Json     @default("{}")
  // FULL = complete retail management; INVENTORY_ONLY = standalone inventory
  // software. Disabled modules are enforced server-side in lib/features.ts;
  // their records are never deleted.
  appMode       AppMode  @default(FULL)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users              User[]
  branches           Branch[]
  categories         Category[]
  products           Product[]
  suppliers          Supplier[]
  customers          Customer[]
  sales              Sale[]
  purchases          Purchase[]
  expenses           Expense[]
  auditLogs          AuditLog[]
  syncRecords        SyncRecord[]
  notifications      Notification[]
  businessInsights   BusinessInsight[]
  inventoryMovements InventoryMovement[]

  @@index([name])
}

// ----------------------------------------------------------------------------
// Users, roles, branches
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String?
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id])
  sales         Sale[]         @relation("SaleCashier")
  expenses      Expense[]      @relation("ExpenseCreatedBy")
  shifts        EmployeeShift[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([businessId])
  @@index([branchId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  address    String?
  phone      String?
  isMain     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users              User[]
  inventoryLevels    InventoryLevel[]
  sales              Sale[]
  purchases          Purchase[]
  expenses           Expense[]
  employeeShifts     EmployeeShift[]
  inventoryMovements InventoryMovement[]

  @@index([businessId])
}

// ----------------------------------------------------------------------------
// Catalog: categories, products, per-branch stock levels
// ----------------------------------------------------------------------------

model Category {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id              String    @id @default(uuid())
  businessId      String
  categoryId      String?
  supplierId      String?
  name            String
  sku             String
  barcode         String?
  description     String?
  costPrice       Decimal   @db.Decimal(12, 2)
  sellingPrice    Decimal   @db.Decimal(12, 2)
  minStockLevel   Int       @default(0)
  maxStockLevel   Int?
  unit            String    @default("Unit")
  imageUrl        String?
  expiryDate      DateTime?
  taxable         Boolean   @default(true)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
}

// Stock is tracked per branch so multi-branch quantities never collide.
model InventoryLevel {
  id        String   @id @default(uuid())
  productId String
  branchId  String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  businessId   String
  branchId     String
  productId    String
  type         InventoryMovementType
  quantity     Int
  reason       String?
  referenceId  String?
  createdById  String?
  createdAt    DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([branchId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Suppliers & purchasing
// ----------------------------------------------------------------------------

model Supplier {
  id             String   @id @default(uuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  address        String?
  outstandingBalance Decimal @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products  Product[]
  purchases Purchase[]

  @@index([businessId])
}

model Purchase {
  id            String         @id @default(uuid())
  businessId    String
  branchId      String
  supplierId    String
  status        PurchaseStatus @default(DRAFT)
  orderedAt     DateTime       @default(now())
  expectedAt    DateTime?
  receivedAt    DateTime?
  totalCost     Decimal        @default(0) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@index([businessId])
  @@index([supplierId])
  @@index([branchId])
}

model PurchaseItem {
  id                String  @id @default(uuid())
  purchaseId        String
  productId         String
  quantityOrdered   Int
  quantityReceived  Int     @default(0)
  unitCost          Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// ----------------------------------------------------------------------------
// Customers & credit
// ----------------------------------------------------------------------------

model Customer {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  phone        String?
  email        String?
  address      String?
  creditLimit  Decimal  @default(0) @db.Decimal(12, 2)
  creditBalance Decimal @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales          Sale[]
  creditAccounts CreditAccount[]

  @@index([businessId])
}

model CreditAccount {
  id             String    @id @default(uuid())
  customerId     String
  saleId         String    @unique
  originalAmount Decimal   @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(12, 2)
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payments CreditPayment[]

  @@index([customerId])
}

model CreditPayment {
  id              String   @id @default(uuid())
  creditAccountId String
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paidAt          DateTime @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([creditAccountId])
}

// ----------------------------------------------------------------------------
// Sales / POS
// ----------------------------------------------------------------------------

model Sale {
  id             String     @id @default(uuid())
  businessId     String
  branchId       String
  cashierId      String
  customerId     String?
  receiptNumber  String
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal    @db.Decimal(12, 2)
  costOfGoods    Decimal    @db.Decimal(12, 2)
  grossProfit    Decimal    @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  clientTxnId    String     // generated on the offline client; used for idempotent sync
  syncStatus     SyncStatus @default(SYNCED)
  voidedReason   String?
  refundedFromId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id])
  cashier       User           @relation("SaleCashier", fields: [cashierId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  payments      Payment[]
  creditAccount CreditAccount?

  @@unique([businessId, clientTxnId]) // enforces idempotent offline sync
  @@unique([businessId, receiptNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([cashierId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  productId    String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  unitCost     Decimal @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)
  lineProfit   Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  createdAt     DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ----------------------------------------------------------------------------
// Expenses
// ----------------------------------------------------------------------------

model Expense {
  id          String          @id @default(uuid())
  businessId  String
  branchId    String?
  createdById String?
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  paymentMethod PaymentMethod
  attachmentUrl String?
  incurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdBy User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([businessId])
  @@index([branchId])
  @@index([incurredAt])
}

// ----------------------------------------------------------------------------
// Employees / shifts
// ----------------------------------------------------------------------------

model EmployeeShift {
  id            String    @id @default(uuid())
  userId        String
  branchId      String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  expectedCash  Decimal?  @db.Decimal(12, 2)
  actualCash    Decimal?  @db.Decimal(12, 2)
  variance      Decimal?  @db.Decimal(12, 2)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([branchId])
}

// ----------------------------------------------------------------------------
// Audit, sync, notifications, insights
// ----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  businessId    String
  userId        String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  branchId      String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SyncRecord {
  id           String     @id @default(uuid())
  businessId   String
  deviceId     String
  entityType   String
  entityId     String
  clientTxnId  String
  status       SyncStatus @default(PENDING)
  conflictInfo Json?
  attemptedAt  DateTime   @default(now())
  resolvedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, clientTxnId])
  @@index([businessId])
  @@index([status])
}

model Notification {
  id         String           @id @default(uuid())
  businessId String
  branchId   String?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isRead])
}

// Precomputed / cached business-intelligence observations shown on the dashboard.
model BusinessInsight {
  id         String   @id @default(uuid())
  businessId String
  category   String   // e.g. "sales_trend", "profit_anomaly", "reorder", "dead_stock"
  tone       String   // "good" | "warn" | "bad" | "neutral"
  message    String
  metadata   Json?
  validFrom  DateTime @default(now())
  validUntil DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([category])
}

// ----------------------------------------------------------------------------
// Auth support tables (already present in the database from migrations
// 1_auth_attempts and 2_settings_receipts_resets).
// ----------------------------------------------------------------------------

// One row per failed/attempted auth action, keyed by e.g. "login:<email>".
model AuthAttempt {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// Single-use password reset tokens; only the hash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
