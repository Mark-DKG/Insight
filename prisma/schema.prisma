// ============================================================================
// Insight by 9DEVs — Prisma Schema
// PostgreSQL, multi-tenant (every business-owned table carries businessId)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
  VOIDED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGED
  EXPIRED
  RETURNED
  COUNT_CORRECTION
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  TRANSPORT
  SALARIES
  MAINTENANCE
  MARKETING
  INTERNET
  OTHER
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  DEAD_STOCK
  STOCK_DISCREPANCY
  CUSTOMER_CREDIT_DUE
  SUPPLIER_PAYMENT_DUE
  SYNC_ERROR
  TRANSACTION_FAILED
  GENERAL
  SALES_ACTIVITY
  STORE_APPLICATION
  STORE_LISTING
  STORE_ORDER
  STORE_SELLER
}

// ----------------------------------------------------------------------------
// Tenant root
// ----------------------------------------------------------------------------

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  TECHNICAL_ADMIN
  SUPPORT_ADMIN
  ANALYST
}

// Business operating packages. Enforced server-side in lib/features.ts.
enum AppMode {
  FULL
  INVENTORY_ONLY
  STORE_INVENTORY
  POS_INVENTORY
}

model Business {
  id            String   @id @default(uuid())
  name          String
  logoUrl       String?
  address       String?
  phone         String?
  email         String?
  currency      String   @default("GHS")
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  isDemo        Boolean  @default(false)
  // Counter reserved for sequential receipt numbering.
  receiptCounter Int     @default(0)
  // Per-business preferences (inventory, POS, notification settings).
  settings      Json     @default("{}")
  // FULL = complete retail management; INVENTORY_ONLY = standalone inventory
  // software. Disabled modules are enforced server-side in lib/features.ts;
  // their records are never deleted.
  appMode       AppMode  @default(FULL)
  // Platform-level account status, set by 9DEVs administrators. Suspension
  // blocks sign-in and token refresh; it never deletes business records.
  // Package requested but waiting on Insight Store seller approval.
  pendingAppMode  AppMode?
  // When the owner first chose a package after signup. NULL = still has to
  // choose; until then the business runs on the most restricted package.
  packageSelectedAt DateTime?
  status          BusinessStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users              User[]
  branches           Branch[]
  categories         Category[]
  products           Product[]
  suppliers          Supplier[]
  customers          Customer[]
  sales              Sale[]
  purchases          Purchase[]
  expenses           Expense[]
  auditLogs          AuditLog[]
  syncRecords        SyncRecord[]
  notifications      Notification[]
  businessInsights   BusinessInsight[]
  inventoryMovements InventoryMovement[]
  storeApplications  StoreSellerApplication[]
  storeSeller        StoreSeller?
  storeListings      StoreListing[]
  storeOrders        StoreOrder[]

  @@index([name])
  @@index([status])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Users, roles, branches
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String?
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id])
  sales         Sale[]         @relation("SaleCashier")
  expenses      Expense[]      @relation("ExpenseCreatedBy")
  shifts        EmployeeShift[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  storeApplications StoreSellerApplication[]

  @@index([businessId])
  @@index([branchId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  address    String?
  phone      String?
  isMain     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users              User[]
  inventoryLevels    InventoryLevel[]
  sales              Sale[]
  storeSellers       StoreSeller[]
  storeOrders        StoreOrder[]
  purchases          Purchase[]
  expenses           Expense[]
  employeeShifts     EmployeeShift[]
  inventoryMovements InventoryMovement[]

  @@index([businessId])
}

// ----------------------------------------------------------------------------
// Catalog: categories, products, per-branch stock levels
// ----------------------------------------------------------------------------

model Category {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id              String    @id @default(uuid())
  businessId      String
  categoryId      String?
  supplierId      String?
  name            String
  sku             String
  barcode         String?
  description     String?
  costPrice       Decimal   @db.Decimal(12, 2)
  sellingPrice    Decimal   @db.Decimal(12, 2)
  minStockLevel   Int       @default(0)
  maxStockLevel   Int?
  unit            String    @default("Unit")
  imageUrl        String?
  expiryDate      DateTime?
  taxable         Boolean   @default(true)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  storeListing       StoreListing?
  storeOrderItems    StoreOrderItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
}

// Stock is tracked per branch so multi-branch quantities never collide.
model InventoryLevel {
  id        String   @id @default(uuid())
  productId String
  branchId  String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  businessId   String
  branchId     String
  productId    String
  type         InventoryMovementType
  quantity     Int
  reason       String?
  referenceId  String?
  createdById  String?
  createdAt    DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([branchId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Suppliers & purchasing
// ----------------------------------------------------------------------------

model Supplier {
  id             String   @id @default(uuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  address        String?
  outstandingBalance Decimal @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products  Product[]
  purchases Purchase[]

  @@index([businessId])
}

model Purchase {
  id            String         @id @default(uuid())
  businessId    String
  branchId      String
  supplierId    String
  status        PurchaseStatus @default(DRAFT)
  orderedAt     DateTime       @default(now())
  expectedAt    DateTime?
  receivedAt    DateTime?
  totalCost     Decimal        @default(0) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@index([businessId])
  @@index([supplierId])
  @@index([branchId])
}

model PurchaseItem {
  id                String  @id @default(uuid())
  purchaseId        String
  productId         String
  quantityOrdered   Int
  quantityReceived  Int     @default(0)
  unitCost          Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// ----------------------------------------------------------------------------
// Customers & credit
// ----------------------------------------------------------------------------

model Customer {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  phone        String?
  email        String?
  address      String?
  creditLimit  Decimal  @default(0) @db.Decimal(12, 2)
  creditBalance Decimal @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales          Sale[]
  creditAccounts CreditAccount[]

  @@index([businessId])
}

model CreditAccount {
  id             String    @id @default(uuid())
  customerId     String
  saleId         String    @unique
  originalAmount Decimal   @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(12, 2)
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payments CreditPayment[]

  @@index([customerId])
}

model CreditPayment {
  id              String   @id @default(uuid())
  creditAccountId String
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paidAt          DateTime @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([creditAccountId])
}

// ----------------------------------------------------------------------------
// Sales / POS
// ----------------------------------------------------------------------------

model Sale {
  id             String     @id @default(uuid())
  businessId     String
  branchId       String
  cashierId      String
  customerId     String?
  receiptNumber  String
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal    @db.Decimal(12, 2)
  costOfGoods    Decimal    @db.Decimal(12, 2)
  grossProfit    Decimal    @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  clientTxnId    String     // generated on the offline client; used for idempotent sync
  syncStatus     SyncStatus @default(SYNCED)
  voidedReason   String?
  refundedFromId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id])
  cashier       User           @relation("SaleCashier", fields: [cashierId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  payments      Payment[]
  creditAccount CreditAccount?

  @@unique([businessId, clientTxnId]) // enforces idempotent offline sync
  @@unique([businessId, receiptNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([cashierId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  productId    String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  unitCost     Decimal @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)
  lineProfit   Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  createdAt     DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ----------------------------------------------------------------------------
// Expenses
// ----------------------------------------------------------------------------

model Expense {
  id          String          @id @default(uuid())
  businessId  String
  branchId    String?
  createdById String?
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  paymentMethod PaymentMethod
  attachmentUrl String?
  incurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdBy User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([businessId])
  @@index([branchId])
  @@index([incurredAt])
}

// ----------------------------------------------------------------------------
// Employees / shifts
// ----------------------------------------------------------------------------

model EmployeeShift {
  id            String    @id @default(uuid())
  userId        String
  branchId      String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  expectedCash  Decimal?  @db.Decimal(12, 2)
  actualCash    Decimal?  @db.Decimal(12, 2)
  variance      Decimal?  @db.Decimal(12, 2)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([branchId])
}

// ----------------------------------------------------------------------------
// Audit, sync, notifications, insights
// ----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  businessId    String
  userId        String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  branchId      String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SyncRecord {
  id           String     @id @default(uuid())
  businessId   String
  deviceId     String
  entityType   String
  entityId     String
  clientTxnId  String
  status       SyncStatus @default(PENDING)
  conflictInfo Json?
  attemptedAt  DateTime   @default(now())
  resolvedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, clientTxnId])
  @@index([businessId])
  @@index([status])
}

model Notification {
  id         String           @id @default(uuid())
  businessId String
  branchId   String?
  // Recipient. Notifications are delivered per user so read state is per user.
  userId     String?
  type       NotificationType
  title      String
  message    String
  // In-app path to open when the notification is clicked.
  link       String?
  // Prevents the same event notifying the same user twice.
  dedupeKey  String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([businessId])
  @@index([isRead])
  @@index([userId, isRead, createdAt])
}

// Precomputed / cached business-intelligence observations shown on the dashboard.
model BusinessInsight {
  id         String   @id @default(uuid())
  businessId String
  category   String   // e.g. "sales_trend", "profit_anomaly", "reorder", "dead_stock"
  tone       String   // "good" | "warn" | "bad" | "neutral"
  message    String
  metadata   Json?
  validFrom  DateTime @default(now())
  validUntil DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([category])
}

// ----------------------------------------------------------------------------
// Auth support tables (already present in the database from migrations
// 1_auth_attempts and 2_settings_receipts_resets).
// ----------------------------------------------------------------------------

// One row per failed/attempted auth action, keyed by e.g. "login:<email>".
model AuthAttempt {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// Single-use password reset tokens; only the hash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Platform administration (9DEVs operators) — separate from business users.
// See lib/admin/* and migration 4_platform_admin.
// ----------------------------------------------------------------------------

model PlatformAdmin {
  id                 String       @id @default(uuid())
  email              String       @unique
  name               String
  passwordHash       String
  role               PlatformRole
  // Permissions granted on top of the role's defaults (lib/admin/permissions.ts).
  extraPermissions   String[]     @default([])
  isActive           Boolean      @default(true)
  // TOTP secret, AES-256-GCM encrypted with PLATFORM_ADMIN_SECRET.
  mfaSecret          String?
  mfaEnabled         Boolean      @default(false)
  mustChangePassword Boolean      @default(true)
  lastLoginAt        DateTime?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  sessions          PlatformAdminSession[]
  notificationReads PlatformNotificationRead[]
}

model PlatformAdminSession {
  id         String    @id @default(uuid())
  adminId    String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// Append-only: a database trigger rejects UPDATE, DELETE and TRUNCATE.
model PlatformAuditLog {
  id               String   @id @default(uuid())
  actorId          String?
  actorEmail       String?
  actorRole        String?
  action           String
  targetBusinessId String?
  targetType       String?
  targetId         String?
  reason           String?
  before           Json?
  after            Json?
  ip               String?
  requestId        String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([targetBusinessId])
  @@index([actorId])
  @@index([action, createdAt])
}

model PlatformNotification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  link      String?
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  reads PlatformNotificationRead[]

  @@index([createdAt])
}

model PlatformNotificationRead {
  notificationId String
  adminId        String
  readAt         DateTime @default(now())

  notification PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        PlatformAdmin        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([notificationId, adminId])
}

// ----------------------------------------------------------------------------
// Insight Store (central multi-vendor marketplace). Migration 5_insight_store.
// Listings are a publication layer over existing Products: no duplicate
// catalogue and no separate stock figure (availability = InventoryLevel).
// ----------------------------------------------------------------------------

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
}

enum StoreOrderStatus {
  NEW
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_COLLECTION
  DISPATCHED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum StorePaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum StoreFulfilment {
  DELIVERY
  COLLECTION
}

model StoreConfig {
  id                String   @id
  isOpen            Boolean  @default(true)
  announcement      String?
  policies          String?
  orderExpiryHours  Int      @default(48)
  requiredDocuments Json     @default("[]")
  updatedAt         DateTime @default(now()) @updatedAt
}

model StoreSellerApplication {
  id               String                  @id @default(uuid())
  reference        String                  @unique
  businessId       String
  applicantUserId  String?
  status           SellerApplicationStatus @default(DRAFT)
  data             Json                    @default("{}")
  requestedAppMode AppMode?
  infoRequest      String?
  decisionReason   String?
  decidedByAdminId String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt

  business  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  applicant User?                   @relation(fields: [applicantUserId], references: [id], onDelete: SetNull)
  events    StoreApplicationEvent[]
  documents StoreDocument[]

  @@index([businessId])
  @@index([status, submittedAt])
}

model StoreApplicationEvent {
  id            String   @id @default(uuid())
  applicationId String
  actorType     String
  actorId       String?
  actorLabel    String?
  action        String
  fromStatus    String?
  toStatus      String?
  note          String?
  internal      Boolean  @default(false)
  createdAt     DateTime @default(now())

  application StoreSellerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model StoreDocument {
  id               String   @id @default(uuid())
  applicationId    String
  businessId       String
  docKey           String
  fileName         String
  mimeType         String
  sizeBytes        Int
  sha256           String
  data             Bytes
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  application StoreSellerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model StoreSeller {
  id                    String       @id @default(uuid())
  businessId            String       @unique
  status                SellerStatus @default(ACTIVE)
  slug                  String       @unique
  approvedApplicationId String?
  approvedAt            DateTime     @default(now())
  description           String?
  city                  String?
  region                String?
  country               String?
  publicPhone           String?
  whatsappNumber        String?
  publicEmail           String?
  openingHours          String?
  offersDelivery        Boolean      @default(false)
  deliveryInfo          String?
  offersCollection      Boolean      @default(true)
  collectionInfo        String?
  fulfilmentBranchId    String?
  isFeatured            Boolean      @default(false)
  suspendedAt           DateTime?
  suspendedReason       String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @default(now()) @updatedAt

  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fulfilmentBranch  Branch?  @relation(fields: [fulfilmentBranchId], references: [id], onDelete: SetNull)

  @@index([status])
}

model StoreCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  listings StoreListing[]
}

model StoreListing {
  id                String        @id @default(uuid())
  businessId        String
  productId         String        @unique
  categoryId        String?
  title             String
  description       String?
  // Marketplace price; null means use the product's selling price.
  price             Decimal?      @db.Decimal(12, 2)
  status            ListingStatus @default(DRAFT)
  isVisible         Boolean       @default(true)
  isFeatured        Boolean       @default(false)
  rejectionReason   String?
  submittedAt       DateTime?
  publishedAt       DateTime?
  reviewedByAdminId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   StoreCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  events     StoreListingEvent[]
  images     StoreImage[]
  cartItems  StoreCartItem[]
  orderItems StoreOrderItem[]

  @@index([businessId, status])
  @@index([status, isVisible, publishedAt])
  @@index([categoryId])
}

model StoreListingEvent {
  id         String   @id @default(uuid())
  listingId  String
  actorType  String
  actorId    String?
  actorLabel String?
  action     String
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime @default(now())

  listing StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

model StoreImage {
  id         String   @id @default(uuid())
  businessId String
  listingId  String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int      @default(0)
  data       Bytes
  createdAt  DateTime @default(now())

  listing StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model StoreCart {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime

  items StoreCartItem[]
}

model StoreCartItem {
  id        String   @id @default(uuid())
  cartId    String
  listingId String
  quantity  Int
  createdAt DateTime @default(now())

  cart    StoreCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
}

model StoreOrder {
  id                      String             @id @default(uuid())
  reference               String             @unique
  checkoutId              String
  businessId              String
  branchId                String?
  status                  StoreOrderStatus   @default(NEW)
  paymentStatus           StorePaymentStatus @default(UNPAID)
  currency                String
  subtotal                Decimal            @db.Decimal(12, 2)
  customerName            String
  customerPhone           String
  customerEmail           String?
  fulfilment              StoreFulfilment
  deliveryAddress         String?
  note                    String?
  lookupTokenHash         String
  // True once stock has been taken from the inventory ledger (at seller
  // confirmation); guards against double deduction and drives restoration.
  stockDeducted           Boolean            @default(false)
  whatsappLinkGeneratedAt DateTime?
  whatsappOpenedAt        DateTime?
  attributionChannel      String?
  expiresAt               DateTime
  confirmedAt             DateTime?
  completedAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @default(now()) @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items    StoreOrderItem[]
  events   StoreOrderEvent[]

  @@index([businessId, status, createdAt])
  @@index([checkoutId])
  @@index([status, expiresAt])
}

model StoreOrderItem {
  id            String        @id @default(uuid())
  orderId       String
  listingId     String?
  productId     String
  titleSnapshot String
  skuSnapshot   String?
  unitPrice     Decimal       @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal       @db.Decimal(12, 2)

  order   StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing StoreListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model StoreOrderEvent {
  id         String   @id @default(uuid())
  orderId    String
  actorType  String
  actorId    String?
  actorLabel String?
  fromStatus String?
  toStatus   String?
  action     String
  note       String?
  createdAt  DateTime @default(now())

  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model StoreCheckout {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}

model StoreAttributionEvent {
  id         String   @id @default(uuid())
  channel    String
  event      String
  targetType String
  targetId   String
  businessId String?
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([channel, event, createdAt])
  @@index([businessId, createdAt])
}
